# Base de datos PostgreSQL (Neon, Vercel Postgres, Supabase o local vía docker-compose.yml)
DATABASE_URL="postgresql://ciocolatto:ciocolatto@localhost:5434/ciocolatto?schema=public"

# Auth.js — generar con: npx auth secret  (o: openssl rand -base64 33)
AUTH_SECRET="reemplazar-por-un-valor-aleatorio-largo"

# URL pública del sitio (usada por Auth.js en producción)
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del usuario admin creado por el seed inicial (prisma/seed.ts).
# Cambiar la contraseña después del primer login.
SEED_ADMIN_EMAIL="admin@ciocolatto.com"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# Número de WhatsApp de fallback. El valor real y editable vive en Settings (Admin → Configuración → WhatsApp);
# esta variable solo se usa si Settings todavía no tiene un número cargado.
WHATSAPP_NUMBER="5491100000000"
